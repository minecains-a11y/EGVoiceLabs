# ==========================================
# EGVoiceLabs (EGVL) Configuration
# ==========================================

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="EGVoiceLabs"
NEXT_PUBLIC_APP_TAGLINE="Your voice. Your sound. Your lab."

# Mode: 'mock' for in-browser client & simulated backend generation, 'production' for live models
AI_PROVIDER_MODE=mock

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/egvl?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/egvl?schema=public"

# Authentication (Clerk or Supabase)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample
CLERK_SECRET_KEY=sk_test_sample
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Storage (Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID=sample_r2_account_id
R2_ACCESS_KEY_ID=sample_access_key
R2_SECRET_ACCESS_KEY=sample_secret_key
R2_BUCKET_NAME=egvl-audio
R2_PUBLIC_URL=https://media.egvoicelabs.com

# Redis / Queue (Upstash / Redis)
REDIS_URL="redis://localhost:6379"

# Stripe Billing & Credits
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample

# AI Inference Providers (Open Source / Hosted)
# TTS & Voice Cloning (XTTS-v2 / F5-TTS / Modal / Replicate)
REPLICATE_API_TOKEN=r8_sample_token
MODAL_API_ENDPOINT=https://egvl-inference--fastapi-app.modal.run
OPENAI_API_KEY=sk-sample-for-whisper-and-moderation

# Audio Watermark Secret
AUDIO_WATERMARK_SECRET=egvl_secure_watermark_salt_2026
